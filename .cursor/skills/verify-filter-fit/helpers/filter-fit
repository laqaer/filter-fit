#!/usr/bin/env node
"use strict";

const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const net = require("node:net");
const { spawn } = require("node:child_process");

const HOME_TITLE = "FilterFit — Furnace filters by MERV, size, and depth";
const HOME_H1 = "Pick a furnace filter by size, slot depth, then MERV";
const DEFAULT_PORT = 4321;
const DEFAULT_HOST = "127.0.0.1";

function fail(message) {
  const error = new Error(message);
  error.userFail = true;
  throw error;
}

function sleep(ms) {
  return new Promise((resolve) => setTimeout(resolve, ms));
}

function repoRoot() {
  const fromEnv = process.env.FILTERFIT_ROOT;
  const root = path.resolve(fromEnv || process.cwd());
  const pkgPath = path.join(root, "package.json");
  if (!fs.existsSync(pkgPath)) fail(`no package.json at ${root}. Run from the filter-fit repo root.`);
  const pkg = JSON.parse(fs.readFileSync(pkgPath, "utf8"));
  if (pkg.name !== "filter-fit") fail(`package name is ${pkg.name}, not filter-fit. Run from the filter-fit repo root.`);
  return root;
}

function config() {
  const port = Number(process.env.FILTERFIT_PORT || DEFAULT_PORT);
  const host = process.env.FILTERFIT_HOST || DEFAULT_HOST;
  if (!Number.isInteger(port) || port < 1024 || port > 65535) {
    fail(`FILTERFIT_PORT must be an integer from 1024 to 65535 (got ${process.env.FILTERFIT_PORT}).`);
  }
  if (host !== DEFAULT_HOST) {
    fail(`refusing host ${host}. Verification binds ${DEFAULT_HOST} only.`);
  }
  if (port === 3000) {
    fail(
      "refusing :3000. The documented `npm run dev` binds port 3000. This skill only drives an instance it launched on another port (default 4321). A shared or foreign :3000 server is not a verification target.",
    );
  }
  return { port, host, root: repoRoot(), mode: process.env.FILTERFIT_MODE || "dev" };
}

function runDir(port) {
  return path.join(os.tmpdir(), `filter-fit-verify-${port}`);
}

function instancePath(port) {
  return path.join(runDir(port), "instance.json");
}

function readInstance(port) {
  const file = instancePath(port);
  if (!fs.existsSync(file)) return null;
  return JSON.parse(fs.readFileSync(file, "utf8"));
}

function pidAlive(pid) {
  if (!pid) return false;
  try {
    process.kill(pid, 0);
    return true;
  } catch {
    return false;
  }
}

function cmdline(pid) {
  try {
    return fs.readFileSync(`/proc/${pid}/cmdline`, "utf8").replace(/\0/g, " ");
  } catch {
    return "";
  }
}

function procCwd(pid) {
  try {
    return fs.readlinkSync(`/proc/${pid}/cwd`);
  } catch {
    return "";
  }
}

function ppidOf(pid) {
  try {
    const raw = fs.readFileSync(`/proc/${pid}/stat`, "utf8");
    const close = raw.lastIndexOf(")");
    const rest = raw.slice(close + 2).trim().split(/\s+/);
    return Number(rest[1] || 0);
  } catch {
    return 0;
  }
}

function isInTree(pid, rootPid) {
  const seen = new Set();
  let current = pid;
  while (current && !seen.has(current)) {
    if (current === rootPid) return true;
    seen.add(current);
    current = ppidOf(current);
  }
  return false;
}

function listeningPids(port) {
  const hex = port.toString(16).toUpperCase().padStart(4, "0");
  const inodes = new Set();
  for (const file of ["/proc/net/tcp", "/proc/net/tcp6"]) {
    let text = "";
    try {
      text = fs.readFileSync(file, "utf8");
    } catch {
      continue;
    }
    for (const line of text.split("\n").slice(1)) {
      const parts = line.trim().split(/\s+/);
      if (parts.length < 10 || parts[3] !== "0A") continue;
      const portHex = (parts[1].split(":")[1] || "").toUpperCase();
      if (portHex === hex) inodes.add(parts[9]);
    }
  }
  if (inodes.size === 0) return [];
  const pids = [];
  let entries = [];
  try {
    entries = fs.readdirSync("/proc");
  } catch {
    return [];
  }
  for (const entry of entries) {
    if (!/^\d+$/.test(entry)) continue;
    let fds = [];
    try {
      fds = fs.readdirSync(`/proc/${entry}/fd`);
    } catch {
      continue;
    }
    for (const fd of fds) {
      let link = "";
      try {
        link = fs.readlinkSync(`/proc/${entry}/fd/${fd}`);
      } catch {
        continue;
      }
      const match = /socket:\[(\d+)\]/.exec(link);
      if (match && inodes.has(match[1])) {
        pids.push(Number(entry));
        break;
      }
    }
  }
  return pids;
}

function originOf(cfg) {
  return `http://${cfg.host}:${cfg.port}`;
}

function decodeEntities(text) {
  return text
    .replace(/&nbsp;/gi, " ")
    .replace(/&amp;/gi, "&")
    .replace(/&lt;/gi, "<")
    .replace(/&gt;/gi, ">")
    .replace(/&quot;/gi, '"')
    .replace(/&#39;|&apos;/gi, "'")
    .replace(/&#(\d+);/g, (_, n) => String.fromCodePoint(Number(n)))
    .replace(/&#x([0-9a-f]+);/gi, (_, n) => String.fromCodePoint(parseInt(n, 16)));
}

function stripAriaHidden(html) {
  let result = "";
  let i = 0;
  while (i < html.length) {
    if (html[i] !== "<") {
      const next = html.indexOf("<", i);
      if (next === -1) {
        result += html.slice(i);
        break;
      }
      result += html.slice(i, next);
      i = next;
      continue;
    }
    const end = html.indexOf(">", i);
    if (end === -1) {
      result += html.slice(i);
      break;
    }
    const tag = html.slice(i, end + 1);
    const nameMatch = /^<\s*([a-zA-Z0-9]+)/.exec(tag);
    const selfClosing = /\/>$/.test(tag) || /^<\s*(area|base|br|col|embed|hr|img|input|link|meta|source|track|wbr)\b/i.test(tag);
    const hidden = nameMatch && /aria-hidden\s*=\s*["']true["']/i.test(tag) && !selfClosing;
    if (!hidden) {
      result += tag;
      i = end + 1;
      continue;
    }
    const name = nameMatch[1].toLowerCase();
    let depth = 1;
    i = end + 1;
    while (i < html.length && depth > 0) {
      const nextOpen = html.toLowerCase().indexOf(`<${name}`, i);
      const nextClose = html.toLowerCase().indexOf(`</${name}`, i);
      if (nextClose === -1) {
        i = html.length;
        break;
      }
      if (nextOpen !== -1 && nextOpen < nextClose) {
        const gt = html.indexOf(">", nextOpen);
        if (gt === -1) {
          i = html.length;
          break;
        }
        const chunk = html.slice(nextOpen, gt + 1);
        if (!chunk.endsWith("/>")) depth += 1;
        i = gt + 1;
      } else {
        const gt = html.indexOf(">", nextClose);
        if (gt === -1) {
          i = html.length;
          break;
        }
        depth -= 1;
        i = gt + 1;
      }
    }
  }
  return result;
}

function visibleText(html) {
  return decodeEntities(
    stripAriaHidden(html.replace(/<!--[\s\S]*?-->/g, ""))
      .replace(/<[^>]+>/g, " ")
      .replace(/\s+/g, " "),
  ).trim();
}

function field(html, tag) {
  const match = html.match(new RegExp(`<${tag}\\b[^>]*>([\\s\\S]*?)<\\/${tag}>`, "i"));
  return match ? visibleText(match[1]) : "";
}

function anchors(html) {
  const cleaned = html.replace(/<!--[\s\S]*?-->/g, "");
  const found = [];
  const re = /<a\b([^>]*)>([\s\S]*?)<\/a>/gi;
  let match;
  while ((match = re.exec(cleaned))) {
    const hrefMatch = /\bhref\s*=\s*(?:"([^"]*)"|'([^']*)'|([^\s>]+))/i.exec(match[1]);
    const raw = hrefMatch ? hrefMatch[1] ?? hrefMatch[2] ?? hrefMatch[3] : "";
    found.push({ href: decodeEntities(raw), name: visibleText(match[2]) });
  }
  return found;
}

function jsonLdTypes(html) {
  const types = [];
  const re = /<script\b[^>]*type\s*=\s*["']application\/ld\+json["'][^>]*>([\s\S]*?)<\/script>/gi;
  let match;
  while ((match = re.exec(html))) {
    try {
      const data = JSON.parse(match[1]);
      const list = Array.isArray(data) ? data : [data];
      for (const item of list) {
        if (item && item["@type"]) types.push(String(item["@type"]));
      }
    } catch {
      types.push("(unparsed)");
    }
  }
  return types;
}

async function request(cfg, urlPath) {
  const url = new URL(urlPath, `${originOf(cfg)}/`);
  if (url.hostname !== cfg.host || String(url.port) !== String(cfg.port)) {
    fail(`refusing to request ${url.href}. Verification only talks to ${originOf(cfg)}.`);
  }
  const response = await fetch(url, { redirect: "manual" });
  const body = await response.text();
  return {
    url: url.href,
    status: response.status,
    body,
    title: field(body, "title"),
    h1: field(body, "h1"),
    headers: response.headers,
  };
}

function printPage(page) {
  console.log(`GET ${page.url} -> ${page.status}`);
  console.log(`title: ${page.title}`);
  console.log(`h1: ${page.h1}`);
}

function assertExpect(haystack, expects) {
  let ok = true;
  for (const expect of expects) {
    if (!haystack.includes(expect)) {
      console.error(`expect missing: ${expect}`);
      ok = false;
    } else {
      console.log(`expect ok: ${expect}`);
    }
  }
  return ok;
}

function assertOwned(cfg) {
  const instance = readInstance(cfg.port);
  if (!instance) {
    fail(`no instance.json at ${instancePath(cfg.port)}. Launch this run's server before driving. Do not attach to a server you did not start.`);
  }
  if (instance.host !== cfg.host || Number(instance.port) !== cfg.port) {
    fail(`instance.json is ${instance.host}:${instance.port}, not ${cfg.host}:${cfg.port}.`);
  }
  if (path.resolve(instance.cwd) !== path.resolve(cfg.root)) {
    fail(`instance.json cwd is ${instance.cwd}, not ${cfg.root}. Refusing to drive another checkout.`);
  }
  if (!pidAlive(instance.pid)) {
    fail(`instance pid ${instance.pid} is not alive. Run cleanup, then launch again.`);
  }
  const command = cmdline(instance.pid);
  const expected =
    instance.mode === "export"
      ? command.includes("serve-export.mjs")
      : command.includes("next") && command.includes(String(cfg.port));
  if (!expected) {
    fail(`pid ${instance.pid} cmdline is not this run's server: ${command}`);
  }
  const listeners = listeningPids(cfg.port);
  for (const pid of listeners) {
    if (!isInTree(pid, instance.pid)) {
      fail(`port ${cfg.port} listener pid ${pid} is not in launch pid ${instance.pid}'s process tree. Refusing a foreign instance.`);
    }
  }
  return { instance, listeners };
}

function childEnv(cfg) {
  const env = { ...process.env, PORT: String(cfg.port), NEXT_TELEMETRY_DISABLED: "1" };
  delete env.ADSENSE_PUB_ID;
  return env;
}

async function waitReady(cfg, pid, logFile) {
  const deadline = Date.now() + 90000;
  let last = "no response";
  while (Date.now() < deadline) {
    if (!pidAlive(pid)) {
      const tail = fs.existsSync(logFile) ? fs.readFileSync(logFile, "utf8").slice(-2000) : "";
      fail(`server pid ${pid} exited before ready.\n${tail}`);
    }
    try {
      const page = await request(cfg, "/");
      if (page.status === 200 && page.body.includes(HOME_H1) && page.body.includes("FilterFit")) {
        return page;
      }
      last = `status ${page.status} h1 ${page.h1}`;
    } catch (error) {
      last = error.message;
    }
    await sleep(400);
  }
  try {
    process.kill(-pid, "SIGTERM");
  } catch {
    try {
      process.kill(pid, "SIGTERM");
    } catch {
      /* already gone */
    }
  }
  const tail = fs.existsSync(logFile) ? fs.readFileSync(logFile, "utf8").slice(-2000) : "";
  fail(`timed out waiting for ${originOf(cfg)} to serve the FilterFit hub (${last}).\n${tail}`);
}

async function launch(cfg) {
  if (cfg.mode !== "dev" && cfg.mode !== "export") {
    fail("FILTERFIT_MODE must be dev (default) or export.");
  }
  const existing = readInstance(cfg.port);
  if (existing && pidAlive(existing.pid)) {
    fail(`instance pid ${existing.pid} is already recorded for port ${cfg.port}. Run doctor, or cleanup before launching again.`);
  }
  const listeners = listeningPids(cfg.port);
  if (listeners.length) {
    fail(`port ${cfg.port} is already in use by pid ${listeners.join(", ")}. Refusing to share it. Pick another FILTERFIT_PORT, or cleanup only if that pid is this skill's instance.`);
  }
  const dir = runDir(cfg.port);
  fs.rmSync(dir, { recursive: true, force: true });
  fs.mkdirSync(dir, { recursive: true });
  const logFile = path.join(dir, "next.log");
  const logFd = fs.openSync(logFile, "a");
  let command;
  let args;
  if (cfg.mode === "dev") {
    command = path.join(cfg.root, "node_modules", ".bin", "next");
    if (!fs.existsSync(command)) fail(`missing ${command}. Run npm install from the repo root.`);
    args = ["dev", "--hostname", cfg.host, "--port", String(cfg.port)];
  } else {
    const index = path.join(cfg.root, "out", "index.html");
    if (!fs.existsSync(index)) {
      fail("FILTERFIT_MODE=export needs out/index.html. Run npm run build first. next start refuses output: export; this mode uses scripts/serve-export.mjs.");
    }
    command = process.execPath;
    args = [path.join(cfg.root, "scripts", "serve-export.mjs")];
  }
  const child = spawn(command, args, {
    cwd: cfg.root,
    env: childEnv(cfg),
    detached: true,
    stdio: ["ignore", logFd, logFd],
  });
  child.unref();
  fs.closeSync(logFd);
  const page = await waitReady(cfg, child.pid, logFile);
  const instance = {
    pid: child.pid,
    host: cfg.host,
    port: cfg.port,
    mode: cfg.mode,
    cwd: cfg.root,
    startedAt: new Date().toISOString(),
    log: logFile,
  };
  fs.writeFileSync(instancePath(cfg.port), JSON.stringify(instance, null, 2));
  console.log(`launched pid=${child.pid} ${originOf(cfg)}`);
  console.log(`log: ${logFile}`);
  printPage(page);
}

async function doctor(cfg) {
  const { instance, listeners } = assertOwned(cfg);
  const page = await request(cfg, "/");
  const failures = [];
  console.log(`pid: ${instance.pid} alive`);
  console.log(`mode: ${instance.mode}`);
  console.log(`cwd: ${instance.cwd}`);
  console.log(`listeners: ${listeners.length ? listeners.join(", ") : "(none visible)"}`);
  printPage(page);
  if (page.status !== 200) failures.push(`GET / status ${page.status}`);
  if (page.title !== HOME_TITLE) failures.push(`title is ${JSON.stringify(page.title)}`);
  if (page.h1 !== HOME_H1) failures.push(`h1 is ${JSON.stringify(page.h1)}`);
  if (!page.body.includes("FilterFit")) failures.push("body missing FilterFit");
  if (failures.length) {
    for (const item of failures) console.error(`fail: ${item}`);
    fail("doctor: fail");
  }
  console.log("doctor: pass");
}

function takeStatus(opts, fallback) {
  return opts.status == null ? fallback : opts.status;
}

function parseRest(argv) {
  const positional = [];
  const opts = { expect: [], name: [], nth: 1, screenshot: false };
  for (let i = 0; i < argv.length; i += 1) {
    const arg = argv[i];
    const next = () => {
      i += 1;
      if (argv[i] == null) fail(`missing value after ${arg}`);
      return argv[i];
    };
    if (arg === "--expect") opts.expect.push(next());
    else if (arg === "--name") opts.name.push(next());
    else if (arg === "--from") opts.from = next();
    else if (arg === "--dir") opts.dir = next();
    else if (arg === "--out") opts.out = next();
    else if (arg === "--feature") opts.feature = next();
    else if (arg === "--follow-name") opts.followName = next();
    else if (arg === "--nth") opts.nth = Number(next());
    else if (arg === "--status") opts.status = Number(next());
    else if (arg === "--as") opts.as = next();
    else if (arg === "--action") opts.action = next();
    else if (arg === "--screenshot") {
      if (argv[i + 1] && !argv[i + 1].startsWith("--")) opts.screenshot = next();
      else opts.screenshot = true;
    }
    else if (arg.startsWith("--")) fail(`unknown flag ${arg}`);
    else positional.push(arg);
  }
  if (opts.nth != null && (!Number.isInteger(opts.nth) || opts.nth < 1)) fail("--nth must be an integer >= 1");
  return { positional, opts };
}

function quoteArg(arg) {
  if (arg !== "" && /^[A-Za-z0-9_./:@%=+-]+$/.test(arg)) return arg;
  return `'${String(arg).replace(/'/g, `'\\''`)}'`;
}

function appendProof(dir, feature, extra) {
  if (!feature) return;
  fs.mkdirSync(dir, { recursive: true });
  const command = ["filter-fit", ...process.argv.slice(2).map(quoteArg)].join(" ");
  const block = [`feature: ${feature}`, `command: ${command}`, `at: ${new Date().toISOString()}`, extra, ""].filter(Boolean).join("\n") + "\n";
  fs.appendFileSync(path.join(dir, "PROOF.txt"), block);
}

function snapshotText(page) {
  const h2 = [...page.body.matchAll(/<h2\b[^>]*>([\s\S]*?)<\/h2>/gi)].map((match) => visibleText(match[1]));
  const navs = [];
  const navRe = /<nav\b([^>]*)>([\s\S]*?)<\/nav>/gi;
  let nav;
  while ((nav = navRe.exec(page.body))) {
    const label = /aria-label\s*=\s*"([^"]*)"/i.exec(nav[1]);
    const links = anchors(nav[2]).map((link) => `${link.name} -> ${link.href}`);
    navs.push(`nav ${label ? label[1] : "(unlabeled)"}:\n${links.map((line) => `- ${line}`).join("\n")}`);
  }
  const linkLines = anchors(page.body).map((link) => `- ${link.name} -> ${link.href}`);
  return [
    `url: ${page.url}`,
    `status: ${page.status}`,
    `title: ${page.title}`,
    `h1: ${page.h1}`,
    "h2:",
    ...h2.map((item) => `- ${item}`),
    ...navs,
    "jsonld:",
    ...jsonLdTypes(page.body).map((item) => `- ${item}`),
    "links:",
    ...linkLines,
    "",
  ].join("\n");
}

async function saveSnapshot(cfg, page, dir, name, feature) {
  fs.mkdirSync(dir, { recursive: true });
  const base = path.join(dir, name);
  fs.writeFileSync(`${base}.html`, page.body);
  fs.writeFileSync(`${base}.txt`, snapshotText(page));
  const meta = {
    url: page.url,
    status: page.status,
    title: page.title,
    h1: page.h1,
    capturedAt: new Date().toISOString(),
    feature: feature || null,
  };
  fs.writeFileSync(`${base}.meta.json`, JSON.stringify(meta, null, 2));
  console.log(`saved ${base}.html`);
  console.log(`saved ${base}.txt`);
  console.log(`saved ${base}.meta.json`);
  return base;
}

function chromeBin() {
  const fromEnv = process.env.FILTERFIT_CHROME;
  if (fromEnv) return fromEnv;
  for (const candidate of ["/usr/local/bin/google-chrome", "/usr/bin/google-chrome", "/usr/bin/chromium"]) {
    if (fs.existsSync(candidate)) return candidate;
  }
  return "google-chrome";
}

function freePort() {
  return new Promise((resolve, reject) => {
    const server = net.createServer();
    server.once("error", reject);
    server.listen(0, "127.0.0.1", () => {
      const address = server.address();
      server.close(() => resolve(address.port));
    });
  });
}

async function screenshotFile(url, outFile) {
  const bin = chromeBin();
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "filter-fit-chrome-"));
  const abs = path.resolve(outFile);
  fs.mkdirSync(path.dirname(abs), { recursive: true });
  const stderrPath = path.join(dir, "chrome.err");
  const stderrFd = fs.openSync(stderrPath, "w");
  const child = spawn(
    bin,
    [
      "--headless=new",
      "--no-sandbox",
      "--disable-gpu",
      "--disable-dev-shm-usage",
      "--hide-scrollbars",
      "--window-size=1280,900",
      "--no-first-run",
      `--user-data-dir=${path.join(dir, "profile")}`,
      `--screenshot=${abs}`,
      "--virtual-time-budget=10000",
      url,
    ],
    { stdio: ["ignore", "ignore", stderrFd] },
  );
  let settled = false;
  const done = await new Promise((resolve) => {
    const finish = (ok) => {
      if (settled) return;
      settled = true;
      clearTimeout(timer);
      try {
        child.kill("SIGKILL");
      } catch {
        /* already exited */
      }
      resolve(ok && fs.existsSync(abs) && fs.statSync(abs).size > 0);
    };
    const timer = setTimeout(() => finish(true), 20000);
    child.on("error", () => finish(false));
    child.on("exit", () => setTimeout(() => finish(true), 500));
  });
  fs.closeSync(stderrFd);
  const err = fs.existsSync(stderrPath) ? fs.readFileSync(stderrPath, "utf8").slice(-500) : "";
  fs.rmSync(dir, { recursive: true, force: true });
  if (!done) fail(`chrome did not write ${abs}.${err ? `\n${err}` : ""}`);
  console.log(`saved ${abs}`);
}

function connectCdp(wsUrl) {
  if (typeof WebSocket !== "function") {
    fail("click needs the global WebSocket from Node 22 (this repo's CI version). HTTP get and follow still work on older Node.");
  }
  const ws = new WebSocket(wsUrl);
  let nextId = 1;
  const pending = new Map();
  ws.addEventListener("message", (event) => {
    const message = JSON.parse(event.data);
    if (!message.id || !pending.has(message.id)) return;
    const { resolve, reject } = pending.get(message.id);
    pending.delete(message.id);
    if (message.error) reject(new Error(message.error.message || JSON.stringify(message.error)));
    else resolve(message.result || {});
  });
  const ready = new Promise((resolve, reject) => {
    ws.addEventListener("open", () => resolve());
    ws.addEventListener("error", () => reject(new Error("chrome devtools socket failed")));
  });
  return {
    ws,
    ready,
    send(method, params = {}) {
      const id = nextId;
      nextId += 1;
      return new Promise((resolve, reject) => {
        pending.set(id, { resolve, reject });
        ws.send(JSON.stringify({ id, method, params }));
      });
    },
  };
}

async function clickPicker(cfg, opts) {
  if (!opts.name.length) fail("click requires at least one --name");
  const bin = chromeBin();
  const debugPort = await freePort();
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "filter-fit-chrome-"));
  const stderrPath = path.join(dir, "chrome.err");
  const stderrFd = fs.openSync(stderrPath, "w");
  const startUrl = `${originOf(cfg)}/`;
  const child = spawn(
    bin,
    [
      "--headless=new",
      "--no-sandbox",
      "--disable-gpu",
      "--disable-dev-shm-usage",
      "--window-size=1280,900",
      "--no-first-run",
      `--remote-debugging-port=${debugPort}`,
      "--remote-debugging-address=127.0.0.1",
      `--user-data-dir=${path.join(dir, "profile")}`,
      startUrl,
    ],
    { detached: true, stdio: ["ignore", "ignore", stderrFd] },
  );
  const killChrome = () => {
    try {
      process.kill(-child.pid, "SIGKILL");
    } catch {
      try {
        child.kill("SIGKILL");
      } catch {
        /* already gone */
      }
    }
  };
  try {
    let pageTarget = null;
    const deadline = Date.now() + 20000;
    while (Date.now() < deadline && !pageTarget) {
      if (!pidAlive(child.pid)) {
        const err = fs.readFileSync(stderrPath, "utf8").slice(-800);
        fail(`chrome exited before devtools was ready.\n${err}`);
      }
      try {
        const list = await (await fetch(`http://127.0.0.1:${debugPort}/json/list`)).json();
        pageTarget = list.find((item) => item.type === "page" && item.webSocketDebuggerUrl);
      } catch {
        /* chrome still binding the port */
      }
      if (!pageTarget) await sleep(150);
    }
    if (!pageTarget) fail("chrome did not expose a page devtools target");
    const cdp = connectCdp(pageTarget.webSocketDebuggerUrl);
    await cdp.ready;
    await cdp.send("Emulation.setDeviceMetricsOverride", {
      width: 1280,
      height: 900,
      deviceScaleFactor: 1,
      mobile: false,
    });
    await cdp.send("Page.enable");
    await cdp.send("Page.navigate", { url: startUrl });
    await cdp.send("Runtime.evaluate", {
      expression:
        "new Promise((resolve) => { if (document.readyState === 'complete') resolve(true); else window.addEventListener('load', () => resolve(true), { once: true }); })",
      awaitPromise: true,
      returnByValue: true,
    });
    const expression = `(() => {
      const names = ${JSON.stringify(opts.name)};
      const followName = ${JSON.stringify(opts.followName || "")};
      const namedButton = (name) => [...document.querySelectorAll("button")].find((button) => {
        const text = button.innerText.replace(/\\s+/g, " ").trim();
        return text === name || text.startsWith(name + " ");
      });
      return (async () => {
        const clicks = [];
        for (const name of names) {
          let pressed = false;
          for (let attempt = 0; attempt < 40 && !pressed; attempt += 1) {
            const button = namedButton(name);
            if (!button) {
              await new Promise((resolve) => setTimeout(resolve, 150));
              continue;
            }
            button.click();
            await new Promise((resolve) => setTimeout(resolve, 150));
            const again = namedButton(name);
            if (again && again.getAttribute("aria-pressed") === "true") {
              await new Promise((resolve) => setTimeout(resolve, 400));
              const stable = namedButton(name);
              pressed = Boolean(stable && stable.getAttribute("aria-pressed") === "true");
            }
          }
          clicks.push({ name, pressed });
          if (!pressed) break;
        }
        const headline = (document.querySelector("h3")?.innerText || "").replace(/\\s+/g, " ").trim();
        const h1 = (document.querySelector("h1")?.innerText || "").replace(/\\s+/g, " ").trim();
        const panel = document.querySelector("h3")?.parentElement;
        const resultLinks = [...(panel ? panel.querySelectorAll("a") : [])].map((anchor) => ({
          name: anchor.innerText.replace(/\\s+/g, " ").trim(),
          href: anchor.getAttribute("href") || "",
        }));
        return { clicks, headline, h1, resultLinks, text: document.body.innerText };
      })();
    })()`;
    const evaluated = await cdp.send("Runtime.evaluate", {
      expression,
      awaitPromise: true,
      returnByValue: true,
    });
    if (evaluated.exceptionDetails) {
      fail(`click script failed: ${JSON.stringify(evaluated.exceptionDetails)}`);
    }
    const value = evaluated.result?.value;
    if (!value) fail("click script returned no value");
    let screenshotPath = "";
    if (opts.screenshot === true) fail("click --screenshot needs a file path");
    if (typeof opts.screenshot === "string") {
      const shot = await cdp.send("Page.captureScreenshot", { format: "png" });
      screenshotPath = path.resolve(opts.screenshot);
      fs.mkdirSync(path.dirname(screenshotPath), { recursive: true });
      fs.writeFileSync(screenshotPath, Buffer.from(shot.data, "base64"));
      console.log(`saved ${screenshotPath}`);
    }
    cdp.ws.close();
    for (const click of value.clicks) {
      console.log(`click ${JSON.stringify(click.name)} pressed=${click.pressed}`);
      if (!click.pressed) fail(`button ${JSON.stringify(click.name)} did not stay aria-pressed`);
    }
    console.log(`headline: ${value.headline}`);
    console.log(`h1: ${value.h1}`);
    let followed = null;
    if (opts.followName) {
      const matches = value.resultLinks.filter((link) => link.name === opts.followName);
      console.log(`result links: ${value.resultLinks.map((link) => link.name).join(" | ")}`);
      if (!matches.length) {
        fail(`result panel has no link named ${JSON.stringify(opts.followName)}. That name elsewhere on the page does not count.`);
      }
      const href = matches[0].href;
      if (/amazon\.com|tag=laqaer-20/i.test(href) || /^mailto:/i.test(href)) {
        fail(`refusing to open ${href}. Do not follow affiliate or mailto links.`);
      }
      const page = await request(cfg, href);
      printPage(page);
      followed = { name: opts.followName, href, status: page.status, title: page.title, h1: page.h1 };
      if (opts.dir) {
        await saveSnapshot(cfg, page, opts.dir, "arrived", opts.feature);
      }
      const haystack = [value.headline, value.h1, value.text, page.title, page.h1, page.body].join("\n");
      if (!assertExpect(haystack, opts.expect) || page.status !== 200) fail("click: fail");
    } else {
      const haystack = [value.headline, value.h1, value.text].join("\n");
      if (!assertExpect(haystack, opts.expect)) fail("click: fail");
    }
    if (opts.dir) {
      fs.mkdirSync(opts.dir, { recursive: true });
      const record = {
        url: startUrl,
        clicks: value.clicks,
        headline: value.headline,
        h1: value.h1,
        resultLinks: value.resultLinks,
        followed,
        screenshot: screenshotPath || null,
        capturedAt: new Date().toISOString(),
        feature: opts.feature || null,
      };
      const file = path.join(opts.dir, "click.json");
      fs.writeFileSync(file, JSON.stringify(record, null, 2));
      console.log(`saved ${file}`);
      appendProof(opts.dir, opts.feature, `headline: ${value.headline}`);
    }
    console.log("click: pass");
  } finally {
    killChrome();
    fs.closeSync(stderrFd);
    fs.rmSync(dir, { recursive: true, force: true });
  }
}

async function cmdGet(cfg, opts, urlPath) {
  const page = await request(cfg, urlPath);
  printPage(page);
  const wanted = takeStatus(opts, 200);
  const haystack = `${page.title}\n${page.h1}\n${visibleText(page.body)}\n${page.body}`;
  const expectsOk = assertExpect(haystack, opts.expect);
  if (page.status !== wanted || !expectsOk) fail("get: fail");
  console.log("get: pass");
  return page;
}

function resolveLocal(cfg, fromPath, href) {
  if (!href || /^(mailto:|javascript:)/i.test(href)) return { refuse: href || "(empty)" };
  const pageUrl = new URL(fromPath, `${originOf(cfg)}/`);
  const absolute = new URL(href, pageUrl);
  if (absolute.hostname !== cfg.host || String(absolute.port || (absolute.protocol === "https:" ? 443 : 80)) !== String(cfg.port)) {
    return { refuse: absolute.href };
  }
  return { path: `${absolute.pathname}${absolute.search}${absolute.hash}` };
}

async function cmdFollow(cfg, opts) {
  if (!opts.from || opts.name.length !== 1) fail("follow requires --from <path> and exactly one --name <text>");
  const source = await request(cfg, opts.from);
  printPage(source);
  if (source.status !== 200) fail(`source ${opts.from} returned ${source.status}`);
  const name = opts.name[0];
  const matches = anchors(source.body).filter((link) => link.name === name);
  if (!matches.length) fail(`no link named ${JSON.stringify(name)} on ${opts.from}`);
  if (opts.nth > matches.length) fail(`--nth ${opts.nth} but ${opts.from} has ${matches.length} link(s) named ${JSON.stringify(name)}`);
  const chosen = matches[opts.nth - 1];
  console.log(`match ${opts.nth}/${matches.length} href=${chosen.href}`);
  const target = resolveLocal(cfg, opts.from, chosen.href);
  if (target.refuse) fail(`refusing to open ${target.refuse}. Follow only same-origin reader links. Do not open affiliate or mailto links.`);
  const destPath = target.path.split("#")[0] || "/";
  const page = await request(cfg, destPath);
  if (target.path.includes("#")) console.log(`hash: ${target.path.slice(target.path.indexOf("#"))}`);
  printPage(page);
  const haystack = `${page.title}\n${page.h1}\n${visibleText(page.body)}\n${page.body}`;
  const expectsOk = assertExpect(haystack, opts.expect);
  if (page.status !== 200 || !expectsOk) fail("follow: fail");
  if (opts.dir) {
    const action = [
      `from: ${opts.from}`,
      `name: ${name}`,
      `nth: ${opts.nth}/${matches.length}`,
      `href: ${chosen.href}`,
      `dest: ${page.url}`,
      `status: ${page.status}`,
      `title: ${page.title}`,
      `h1: ${page.h1}`,
      "",
    ].join("\n");
    fs.mkdirSync(opts.dir, { recursive: true });
    const actionFile = path.join(opts.dir, opts.action || "action.txt");
    fs.writeFileSync(actionFile, action);
    console.log(`saved ${actionFile}`);
    appendProof(opts.dir, opts.feature, `followed ${name} -> ${chosen.href}`);
  }
  console.log("follow: pass");
}

async function cmdSnapshot(cfg, opts, urlPath) {
  if (!opts.dir) fail("snapshot requires --dir");
  const page = await request(cfg, urlPath);
  printPage(page);
  if (page.status !== (opts.status == null ? 200 : opts.status)) fail("snapshot: fail");
  const name = opts.as || (urlPath === "/" ? "index" : urlPath.replace(/^\/+|\/+$/g, "").replace(/[^\w.-]+/g, "-"));
  await saveSnapshot(cfg, page, opts.dir, name, opts.feature);
  if (opts.screenshot === true) {
    await screenshotFile(page.url, path.join(opts.dir, `${name}.png`));
  } else if (typeof opts.screenshot === "string") {
    await screenshotFile(page.url, opts.screenshot);
  }
  appendProof(opts.dir, opts.feature, `snapshot ${urlPath}`);
  console.log("snapshot: pass");
}

async function cmdScreenshot(cfg, opts, urlPath) {
  if (!opts.out) fail("screenshot requires --out");
  const page = await request(cfg, urlPath);
  if (page.status !== 200) fail(`GET ${urlPath} -> ${page.status}`);
  await screenshotFile(page.url, opts.out);
}

function guideHrefs(root) {
  const source = fs.readFileSync(path.join(root, "lib", "guides.ts"), "utf8");
  return [...source.matchAll(/href:\s*"([^"]+)"/g)].map((match) => match[1]);
}

async function cmdSeo(cfg, opts) {
  const robots = await request(cfg, "/robots.txt");
  const sitemap = await request(cfg, "/sitemap.xml");
  const ads = await request(cfg, "/ads.txt");
  console.log(`GET /robots.txt -> ${robots.status}`);
  console.log(`GET /sitemap.xml -> ${sitemap.status}`);
  console.log(`GET /ads.txt -> ${ads.status}`);
  const failures = [];
  if (robots.status !== 200) failures.push("robots status");
  for (const line of ["User-Agent: *", "Allow: /", "Host: filterfitguide.com", "Sitemap: https://filterfitguide.com/sitemap.xml"]) {
    if (!robots.body.includes(line)) failures.push(`robots missing ${line}`);
  }
  if (sitemap.status !== 200) failures.push("sitemap status");
  const locs = [...sitemap.body.matchAll(/<loc>([^<]+)<\/loc>/g)].map((match) => match[1]);
  const expected = ["https://filterfitguide.com", "https://filterfitguide.com/about", "https://filterfitguide.com/privacy", ...guideHrefs(cfg.root).map((href) => `https://filterfitguide.com${href}`)];
  for (const loc of expected) {
    if (!locs.includes(loc)) failures.push(`sitemap missing ${loc}`);
  }
  if (locs.length !== expected.length) failures.push(`sitemap loc count ${locs.length}, expected ${expected.length}`);
  if (ads.status !== 200) failures.push("ads.txt status");
  if (!ads.body.includes("# FilterFit ads.txt placeholder")) failures.push("ads.txt is not the placeholder");
  if (/^google\.com, pub-\d{16}, DIRECT/m.test(ads.body)) failures.push("ads.txt has a live seller line; local verification strips ADSENSE_PUB_ID");
  if (opts.dir) {
    fs.mkdirSync(opts.dir, { recursive: true });
    fs.writeFileSync(path.join(opts.dir, "robots.txt"), robots.body);
    fs.writeFileSync(path.join(opts.dir, "sitemap.xml"), sitemap.body);
    fs.writeFileSync(path.join(opts.dir, "ads.txt"), ads.body);
    appendProof(opts.dir, opts.feature, "seo robots sitemap ads.txt");
    console.log(`saved ${opts.dir}`);
  }
  if (failures.length) {
    for (const item of failures) console.error(`fail: ${item}`);
    fail("seo: fail");
  }
  console.log(`sitemap locs: ${locs.length}`);
  console.log("seo: pass");
}

async function cleanup(cfg) {
  const instance = readInstance(cfg.port);
  if (!instance) {
    const listeners = listeningPids(cfg.port);
    if (listeners.length) {
      console.log(`no instance.json. Not killing pid ${listeners.join(", ")} on port ${cfg.port}.`);
    } else {
      console.log(`no instance at ${instancePath(cfg.port)}`);
    }
    return;
  }
  if (path.resolve(instance.cwd) !== path.resolve(cfg.root)) {
    fail(`instance.json cwd is ${instance.cwd}, not ${cfg.root}. Refusing to kill another checkout.`);
  }
  const ownedListeners = listeningPids(cfg.port).filter((pid) => pid === instance.pid || isInTree(pid, instance.pid));
  if (pidAlive(instance.pid)) {
    const command = cmdline(instance.pid);
    const owned = command.includes("next") || command.includes("serve-export.mjs");
    if (!owned) fail(`pid ${instance.pid} does not look like this skill's server (${command}). Not killing it.`);
    try {
      process.kill(-instance.pid, "SIGTERM");
    } catch {
      try {
        process.kill(instance.pid, "SIGTERM");
      } catch {
        /* already gone */
      }
    }
    const deadline = Date.now() + 5000;
    while (pidAlive(instance.pid) && Date.now() < deadline) await sleep(100);
    if (pidAlive(instance.pid)) {
      try {
        process.kill(-instance.pid, "SIGKILL");
      } catch {
        try {
          process.kill(instance.pid, "SIGKILL");
        } catch {
          /* already gone */
        }
      }
    }
    if (pidAlive(instance.pid)) fail(`pid ${instance.pid} is still alive after SIGKILL`);
    console.log(`killed pid ${instance.pid}`);
  } else {
    console.log(`pid ${instance.pid} was already gone`);
  }
  for (const pid of ownedListeners) {
    if (!pidAlive(pid)) continue;
    try {
      process.kill(pid, "SIGKILL");
      console.log(`killed leftover listener pid ${pid}`);
    } catch {
      /* already gone */
    }
  }
  fs.rmSync(runDir(cfg.port), { recursive: true, force: true });
  console.log(`removed ${runDir(cfg.port)}`);
  console.log("evidence directory was not touched");
}

function usage() {
  console.log(`filter-fit commands (from the repo root):
  launch
  doctor
  url
  get <path> [--expect text]... [--status N]
  follow --from <path> --name <text> [--nth N] [--expect text]... [--dir dir] [--feature id]
  click --name <button> [--name <button>]... [--follow-name <result link>] [--expect text]... [--dir dir] [--screenshot file] [--feature id]
  snapshot <path> --dir <dir> [--as base] [--screenshot] [--feature id]
  screenshot <path> --out <file>
  seo [--dir dir] [--feature id]
  cleanup

Env: FILTERFIT_PORT (default ${DEFAULT_PORT}), FILTERFIT_HOST (only ${DEFAULT_HOST}), FILTERFIT_MODE=dev|export, FILTERFIT_CHROME.
Port 3000 is refused.`);
}

async function main() {
  const [command, ...rest] = process.argv.slice(2);
  if (!command || command === "help" || command === "--help") {
    usage();
    return;
  }
  const cfg = config();
  if (command === "url") {
    console.log(originOf(cfg));
    return;
  }
  if (command === "launch") {
    await launch(cfg);
    return;
  }
  if (command === "cleanup") {
    await cleanup(cfg);
    return;
  }
  assertOwned(cfg);
  const { positional, opts } = parseRest(rest);
  if (command === "doctor") {
    await doctor(cfg);
    return;
  }
  if (command === "get") {
    if (!positional[0]) fail("get requires a path");
    await cmdGet(cfg, opts, positional[0]);
    return;
  }
  if (command === "follow") {
    await cmdFollow(cfg, opts);
    return;
  }
  if (command === "click") {
    await clickPicker(cfg, opts);
    return;
  }
  if (command === "snapshot") {
    if (!positional[0]) fail("snapshot requires a path");
    await cmdSnapshot(cfg, opts, positional[0]);
    return;
  }
  if (command === "screenshot") {
    if (!positional[0]) fail("screenshot requires a path");
    await cmdScreenshot(cfg, opts, positional[0]);
    return;
  }
  if (command === "seo") {
    await cmdSeo(cfg, opts);
    return;
  }
  fail(`unknown command ${command}`);
}

main().catch((error) => {
  console.error(error.userFail ? error.message : error.stack || error.message);
  process.exit(1);
});
